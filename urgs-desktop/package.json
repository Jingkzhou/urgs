{
  "name": "urgs-desktop",
  "private": true,
  "version": "0.1.12",
  "type": "module",
  "scripts": {
    "prepare:grok": "node scripts/prepare-grok-sidecar.mjs",
    "dev": "pnpm run prepare:grok && tauri dev",
    "build": "pnpm run prepare:grok && tauri build",
    "build:unsigned": "pnpm run prepare:grok && tauri build --config src-tauri/tauri.unsigned.conf.json",
    "build:updater": "pnpm run prepare:grok && node scripts/build-updater.mjs",
    "build:web": "node scripts/build-web.mjs",
    "icon": "tauri icon app-icon.png",
    "test": "node --test scripts/*.test.mjs",
    "verify:windows": "node scripts/verify-windows-bundle.mjs",
    "verify:windows:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-install.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
