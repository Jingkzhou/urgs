{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "吉林银行智能任务中心主窗口权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-confirm",
    "fs:allow-write-file",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$HOME/**" }]
    },
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "process:allow-restart",
    "updater:default"
  ]
}

