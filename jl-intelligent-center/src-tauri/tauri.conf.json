{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "吉林银行智能任务中心",
  "version": "0.1.0",
  "identifier": "com.jilinbank.jlintelligentcenter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "吉林银行智能任务中心",
        "width": 1180,
        "height": 720,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "maximized": false,
        "visible": true,
        "fullscreen": false
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self' customprotocol: asset:; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob: http: https:; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; worker-src 'self' blob:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["jlintelligentcenter"] }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5MTI1NUE4OERDMTc1QwpSV1JjRjl5SVdpV1JDWjdZQUdabmVvV05HYmMxQVREVTFReUZqRlcyUStDelRoYmI5WEZyVWNFVQo=",
      "endpoints": ["https://jl-intelligent-center-updater.invalid/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/grok"],
    "targets": ["app", "msi", "nsis"],
    "createUpdaterArtifacts": true,
    "category": "Business",
    "shortDescription": "吉林银行智能任务中心",
    "longDescription": "吉林银行本地智能体任务执行、协作与工作区管理应用",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"]
      },
      "wix": {
        "language": "zh-CN",
        "upgradeCode": "e7e38cda-f05b-4d12-9f5b-4a978bc4148d"
      }
    }
  }
}
