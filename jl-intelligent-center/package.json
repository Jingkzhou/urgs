{
  "name": "jl-intelligent-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "prepare:grok": "node scripts/prepare-grok-sidecar.mjs",
    "dev": "pnpm run prepare:grok && tauri dev",
    "build": "pnpm run prepare:grok && tauri build",
    "build:unsigned": "pnpm run prepare:grok && tauri build --config src-tauri/tauri.unsigned.conf.json",
    "build:updater": "pnpm run prepare:grok && node scripts/build-updater.mjs",
    "build:debug": "pnpm run prepare:grok && tauri build --debug --bundles app --config src-tauri/tauri.unsigned.conf.json",
    "test": "node --test scripts/*.test.mjs",
    "verify:windows": "node scripts/verify-windows-bundle.mjs",
    "verify:windows:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-install.ps1",
    "test:desktop-compat": "node --test scripts/desktop-compatibility.test.mjs",
    "check:desktop-compat": "node scripts/check-desktop-compatibility.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
