# URGS non-Docker deployment configuration.
# Edit this file on the target server before running bin/deploy.sh install/start.

# Runtime binaries
JAVA_BIN=java
PYTHON_BIN=python3
PIP_INSTALL=1

# File storage root
# 所有业务上传、RAG 文档/向量、Redis 运行数据统一放在 /urgs-data/urgs 下。
DATA_ROOT=/urgs-data/urgs
URGS_PROFILE=/urgs-data/urgs/api/uploads
IM_UPLOAD_PATH=/urgs-data/urgs/api/im-uploads
RAG_DOC_STORE_PATH=/urgs-data/urgs/rag/doc_store
CHROMA_PERSIST_DIRECTORY=/urgs-data/urgs/rag/chroma_db
DOC_STORAGE_PATH=/urgs-data/urgs/rag/doc_store
PARENT_DOC_STORE_PATH=/urgs-data/urgs/rag/parent_store
CLEAN_SAMPLE_DIR=/urgs-data/urgs/rag/clean_samples
DEPLOY_TOOL_WORKDIR=/urgs-data/urgs/db_deploy
LINEAGE_ENGINE_SHARED_DIR=/urgs-data/urgs/lineage/share

# ONLYOFFICE Docs
# URGS_API_BASE_URL 必须是 ONLYOFFICE Document Server 可访问的 API 地址。
ONLYOFFICE_DOCUMENT_SERVER_URL=http://localhost:8088
URGS_API_BASE_URL=http://127.0.0.1:8080
ONLYOFFICE_CALLBACK_SECRET=change-me-onlyoffice-callback-secret
ONLYOFFICE_JWT_SECRET=change-me-onlyoffice-jwt-secret
ONLYOFFICE_PORT=8088
ONLYOFFICE_DB_NAME=onlyoffice
ONLYOFFICE_DB_USER=onlyoffice
ONLYOFFICE_DB_PASSWORD=change-me-onlyoffice-db-password

# Ports
API_PORT=8080
EXECUTOR_PORT=8082
RAG_PORT=8001
AGENT_PORT=8002
DEEPAGENTS_PORT=8003
REDIS_PORT=6379
REDIS_BIND=127.0.0.1
WEB_LISTEN_PORT=18080
WEB_SERVER_NAME=_

# Database
DB_HOST=214.129.29.200
DB_PORT=7900
DB_NAME=urgs
DB_USER=urgs
DB_PASSWORD=urg2ssw%D

# Neo4j
NEO4J_HOST=127.0.0.1
NEO4J_PORT_BOLT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-neo4j-password

