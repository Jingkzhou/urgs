# Java service options
SPRING_PROFILES_ACTIVE=dev
TZ=Asia/Shanghai
API_JAVA_OPTS="-Xms8g -Xmx20g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai"
EXECUTOR_JAVA_OPTS="-Xms2g -Xmx4g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai"

# 性能监控
MONITOR_COLLECT_INTERVAL_MS=60000
MONITOR_SLOW_SQL_INTERVAL_MS=300000
MONITOR_SSH_CONNECT_TIMEOUT_MS=8000
MONITOR_SSH_KNOWN_HOSTS=~/.ssh/known_hosts

# LLM
LLM_API_BASE=http://214.129.22.21:18084/v1
LLM_MODEL=qwen3
LLM_API_KEY=sk-xxx
URGS_API_URL=http://127.0.0.1:8080

# LangGraph agent runtime
AGENT_DATABASE_URL=postgresql+asyncpg://urgs_agent:urgs_agent@127.0.0.1:5432/urgs_agent
AGENT_CHECKPOINT_DATABASE_URL=postgresql://urgs_agent:urgs_agent@127.0.0.1:5432/urgs_agent
AGENT_REDIS_URL=redis://127.0.0.1:6379/1
AGENT_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
AGENT_OPENAI_API_KEY=change-me
AGENT_OPENAI_MODEL=qwen3
AGENT_URGS_API_URL=http://127.0.0.1:8080
AGENT_LINEAGE_URL=http://127.0.0.1:8080
AGENT_API_KEY=change-me
AGENT_CALLBACK_HMAC_SECRET=change-me
AGENT_ENVIRONMENT=development
AGENT_LOG_LEVEL=INFO

# 前端运行时配置
# WEB_WS_URL 留空时，浏览器会自动按当前访问地址生成 ws://<当前主机>/ws/im。
# 只有 WebSocket 需要走不同公网地址时才需要手动填写。
PUBLIC_HOST=
WEB_WS_URL=

# Nginx 后端代理目标
# API 和 Nginx 在同一台服务器时可以留空，默认代理到本机端口。
# 示例：API_TARGET=http://10.0.0.11:8080
API_TARGET=
# 普通 API 多后端负载均衡配置，多个节点用英文逗号分隔，不要加 http://。
# 填写后，/api、/uploads、/profile 和普通 /ws/ 会在这些 API 节点之间转发。
API_UPSTREAM_SERVERS=214.129.29.66:8080,214.129.29.67:8080
# 当前登录 token 存在单个 API 进程内存中，多 API 节点必须使用粘性转发。
# 可选值：ip_hash / off
API_UPSTREAM_STICKY=
# 可选的固定 IM/WebSocket 后端地址。
# 多台 API 服务器部署时，如果 /ws/im 和 /api/im 需要固定到同一台 API 节点，就填写这里。
IM_API_TARGET=

# Nginx integration
# Default is one-click local nginx from the package or target PATH.
# Set NGINX_USE_SYSTEM=1 only when nginx is managed by the operating system
# and NGINX_CONF_DIR exists.
# Set NGINX_ENABLED=0 when nginx is managed manually.
NGINX_ENABLED=1
NGINX_USE_SYSTEM=0
NGINX_CONF_DIR=/etc/nginx/conf.d
NGINX_LOCAL_CONF=

# Fallback only. It serves static files without API proxy, so nginx is preferred.
START_WEB_STATIC=0
WEB_STATIC_PORT=3000

# Redis runtime data directory when redis is selected in the package.
REDIS_DATA_DIR=./data/redis
