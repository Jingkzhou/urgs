# URGS 本地启动配置文件.
# Used by start.sh for local non-Docker development.

# Runtime binaries
JAVA_BIN=java
PYTHON_BIN=python3
PIP_INSTALL=1

# File storage root
DATA_ROOT=./data
URGS_PROFILE=./data/api/uploads
IM_UPLOAD_PATH=./data/api/im-uploads
DEPLOY_TOOL_WORKDIR=./data/db_deploy
LINEAGE_ENGINE_SHARED_DIR=./data/lineage/share

# ONLYOFFICE Docs
# 本地开发默认直连 Document Server，避免未启动 Nginx 时编辑器脚本加载失败。
ONLYOFFICE_DOCUMENT_SERVER_URL=http://localhost:8088
URGS_API_BASE_URL=http://host.docker.internal:8080
ONLYOFFICE_CALLBACK_SECRET=change-me-onlyoffice-callback-secret
ONLYOFFICE_JWT_SECRET=change-me-onlyoffice-jwt-secret
ONLYOFFICE_PORT=8088
ONLYOFFICE_TARGET=http://127.0.0.1:8088
ONLYOFFICE_DB_NAME=onlyoffice
ONLYOFFICE_DB_USER=onlyoffice
ONLYOFFICE_DB_PASSWORD=1qaz2wsx!@QW

# Ports
API_PORT=8080
EXECUTOR_PORT=8082
AGENT_PORT=8002
REDIS_PORT=6379
REDIS_BIND=127.0.0.1
WEB_LISTEN_PORT=18080
WEB_SERVER_NAME=_

# Database
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=urgs
DB_USER=root
DB_PASSWORD=root

# Neo4j
NEO4J_HOST=127.0.0.1
NEO4J_PORT_BOLT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

