# URGS 测试环境部署配置文件.
# Edit this file on the target server before running bin/deploy.sh install/start.

# Runtime binaries
JAVA_BIN=java
PYTHON_BIN=python3
PIP_INSTALL=1

# File storage root
# 所有业务上传和 Redis 运行数据统一放在 /urgs-data/urgs 下。
DATA_ROOT=/urgs-data/urgs
URGS_PROFILE=/urgs-data/urgs/api/uploads
IM_UPLOAD_PATH=/urgs-data/urgs/api/im-uploads
ISSUE_ATTACHMENT_PATH=/urgs-data/urgs/api/attachments
DEPLOY_TOOL_WORKDIR=/urgs-data/urgs/db_deploy
LINEAGE_ENGINE_SHARED_DIR=/urgs-data/urgs/lineage/share

# ONLYOFFICE Docs
# URGS_API_BASE_URL 必须是 ONLYOFFICE Document Server 可访问的 API 地址。
# ONLYOFFICE Document Server 直接暴露 18088，不再通过 URGS Nginx 18080 代理。
ONLYOFFICE_DOCUMENT_SERVER_URL=http://25.18.17.210:18088
URGS_API_BASE_URL=http://25.18.17.210:18080
URGS_CORS_ALLOWED_ORIGINS=http://25.18.17.210:18080,http://25.18.131.65:3200,http://25.18.132.65:3200,http://tauri.localhost,https://tauri.localhost
ONLYOFFICE_CALLBACK_SECRET=change-me-onlyoffice-callback-secret
ONLYOFFICE_JWT_SECRET=1qaz2wsx!@QW
ONLYOFFICE_PORT=18088
ONLYOFFICE_TARGET=http://25.18.17.210:18088
ONLYOFFICE_DB_NAME=onlyoffice
ONLYOFFICE_DB_USER=onlyoffice
ONLYOFFICE_DB_PASSWORD=1qaz2wsx!@QW

# Ports
API_PORT=8080
EXECUTOR_PORT=8082
AGENT_PORT=8002
REDIS_PORT=6379
REDIS_BIND=127.0.0.1
WEB_LISTEN_PORT=18080
WEB_SERVER_NAME=_

# Windows 客户端自动更新，仅允许内网访问。desktop 打包目标会将签名工件发布到该地址。
DESKTOP_UPDATER_BASE_URL=http://25.18.17.210:18080/desktop

# Database
DB_HOST=25.18.146.200
DB_PORT=3306
DB_NAME=urgs
DB_USER=urgs
DB_PASSWORD=urg2ssw%D

# Neo4j
NEO4J_HOST=127.0.0.1
NEO4J_PORT_BOLT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=Neo4j@123456

