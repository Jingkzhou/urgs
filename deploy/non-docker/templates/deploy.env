# URGS non-Docker deployment configuration.
# Edit this file on the target server before running bin/deploy.sh install/start.

# Runtime binaries
JAVA_BIN=java
PYTHON_BIN=python3
PIP_INSTALL=1

# Ports
API_PORT=8080
EXECUTOR_PORT=8082
RAG_PORT=8001
REDIS_PORT=6379
REDIS_BIND=127.0.0.1
WEB_LISTEN_PORT=80
WEB_SERVER_NAME=_

# Database
DB_HOST=214.129.8.200
DB_PORT=7900
DB_NAME=urgs
DB_USER=urgs
DB_PASSWORD=urg2ssw%D

# Neo4j
NEO4J_HOST=127.0.0.1
NEO4J_PORT_BOLT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-neo4j-password

# Java service options
SPRING_PROFILES_ACTIVE=prod
API_JAVA_OPTS="-Xms8g -Xmx20g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -Dfile.encoding=UTF-8"
EXECUTOR_JAVA_OPTS="-Xms2g -Xmx4g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -Dfile.encoding=UTF-8"

# RAG / LLM
LLM_API_BASE=http://214.129.22.21:18084/v1
LLM_MODEL=qwen3
LLM_API_KEY=sk-xxx
URGS_API_URL=http://127.0.0.1:8080

# Frontend runtime config
# Set this to the public address users open in browser, for example:
# WEB_WS_URL=ws://192.168.1.10/ws/im
PUBLIC_HOST=127.0.0.1
WEB_WS_URL=ws://127.0.0.1/ws/im

# Nginx integration
# Default is one-click local nginx from the package or target PATH.
# Set NGINX_USE_SYSTEM=1 only when nginx is managed by the operating system
# and NGINX_CONF_DIR exists.
# Set NGINX_ENABLED=0 when nginx is managed manually.
NGINX_ENABLED=1
NGINX_USE_SYSTEM=0
NGINX_CONF_DIR=/etc/nginx/conf.d
NGINX_LOCAL_CONF=

# Fallback only. It serves static files without API proxy, so nginx is preferred.
START_WEB_STATIC=0
WEB_STATIC_PORT=3000

# Redis runtime data directory when redis is selected in the package.
REDIS_DATA_DIR=
