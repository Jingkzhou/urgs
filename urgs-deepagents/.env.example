DEEPAGENTS_ENVIRONMENT=development
DEEPAGENTS_HOST=0.0.0.0
DEEPAGENTS_PORT=8003
DEEPAGENTS_LOG_LEVEL=INFO
DEEPAGENTS_URGS_API_URL=http://127.0.0.1:8080
DEEPAGENTS_INTERNAL_API_TOKEN=change-me
# Optional override. Leave empty to use System Management -> AI API config default model.
DEEPAGENTS_MODEL=
# Workspace root for loading memory files and skills. start.sh defaults this to the URGS repo root.
DEEPAGENTS_WORKSPACE_ROOT=
# Platform-level memory files, comma or newline separated. Example: /AGENTS.md
DEEPAGENTS_MEMORY_FILES=
# Platform-level skill directories, comma or newline separated.
DEEPAGENTS_SKILL_DIRS=
